# Local development needs none of these. SatzWerk falls back to a SQLite file
# and runs with no password, which is fine on localhost.
#
# These are for a hosted deployment. Set them in your hosting provider's
# settings, not in a file you commit. None is prefixed VITE_, so none of them
# can reach the client bundle.

# Postgres, because a serverless function has no persistent disk. When this is
# set, SatzWerk uses it instead of SQLite and treats the deployment as hosted.
DATABASE_URL=

# Optional. Postgres is reached over a normal TCP connection, which is what the
# tests cover. Set this to "http" to use Neon's HTTP driver instead; it avoids
# connection exhaustion under load, but cannot run the migrations by itself and
# needs a WebSocket implementation configured for the parts that fall back to a
# pool. One learner will not exhaust anything, so TCP is the default.
# SATZWERK_PG_TRANSPORT=http

# Both optional. A hosted deployment with no password set asks for one in the
# browser on first visit and stores the hash in the database, so neither of
# these is needed. Set them only if you would rather the secrets lived here:
#
#   SATZWERK_PASSWORD_HASH   overrides the stored password. `npm run
#                            hash-password` prints one. Setting it disables the
#                            in-app change-password form, which could not take
#                            effect.
#   SATZWERK_SESSION_SECRET  overrides the generated signing key.
# SATZWERK_PASSWORD_HASH=
# SATZWERK_SESSION_SECRET=

# Optional, local only: where to keep the SQLite file. Defaults to
# data/satzwerk.db.
# SATZWERK_DB=data/satzwerk.db

# Optional, for running the tests: a throwaway Postgres for the SQLite/Postgres
# parity suite. Its schema is dropped and recreated, so never point this at a
# database you care about. Unset, those tests skip and npm test needs no
# services at all.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/satzwerk_test
